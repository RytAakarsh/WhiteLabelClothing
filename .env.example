# ==============================================================================
# White Label Clothing - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Public Configuration (Safe for Browser & Client-side code)
# Set these in Cloudflare Pages Dashboard -> Settings -> Environment variables
# for BOTH "Production" and "Preview" environments.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://qtvzxezxyzsvgbauyytt.supabase.co
# Primary standardized publishable key (copy "Publishable key" / anon key from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
# Optional legacy alias (supported for backward compatibility)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# ------------------------------------------------------------------------------
# Supabase Privileged Configuration (DO NOT expose to client / Encrypt in Cloudflare)
# Required for server-side administrative tasks and privileged API routes
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional alias for service role key
# SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Direct PostgreSQL connection (used for migrations and administrative scripts)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_db_password@db.qtvzxezxyzsvgbauyytt.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://whitelabelclothing.pages.dev

# ------------------------------------------------------------------------------
# Store & Admin Settings
# ------------------------------------------------------------------------------
ADMIN_EMAIL=info.whitelabelclothing@gmail.com
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret_here
